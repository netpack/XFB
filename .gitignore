# Build artifacts
*.o
Makefile*
*.a
*.so
*.so.*
*.dll
*.dylib

# Executables.
#
# These are anchored on purpose. An unanchored "XFB" matches a path segment at
# any depth, and because git sets core.ignoreCase on a case-insensitive
# filesystem it also matched the Android app's package directory,
# android/app/src/main/java/pt/netpack/xfb — silently excluding every Kotlin
# source file in the companion app from a commit that looked complete.
# qmake's TARGET is XFB, so the binary lands at the repo root or under src/.
/XFB
/src/XFB
XFB.app/
XFB.exe

# ...but src/XFB.app/Contents/Info.plist is a hand-maintained SOURCE template,
# not a built bundle: src/CMakeLists.txt points MACOSX_BUNDLE_INFO_PLIST at it.
# The "XFB.app/" rule above was hiding it, so configuring a fresh clone on
# macOS failed with 'Info.plist template could not be found'. Git needs the
# parent directories un-ignored before the file can be, then everything else
# under Contents/ is re-ignored so the built Frameworks/, Resources/, MacOS/
# and PkgInfo stay out.
!src/XFB.app/
!src/XFB.app/Contents/
src/XFB.app/Contents/*
!src/XFB.app/Contents/Info.plist

# Build directories
build/
build-*/
tmp/
tmp_*/

# Qt Creator user files
*.pro.user
*.pro.user.*

# Debian package files (the final .deb is a release artifact, not source)
*.deb
*.ddeb

# Arch Linux package files (in build directory only)
*.pkg.tar.zst
*.pkg.tar.xz
*.pkg.tar.gz
/pkg/
/.SRCINFO
# Note: Don't ignore src/ as it contains source code!

# macOS build artifacts
*.dmg

# Windows installer output and portable dist folders (release artifacts, large)
XFB-*-Setup.exe
dist/
dist-windows-*/

