// Windows version resource for XFB.exe — generated by CMake from
// src/xfb_version.rc.in; edit the template, never the generated file.
//
// Without this block every field Windows shows for the executable (publisher,
// product, description, version) is blank, which is what made SmartScreen and
// Smart App Control report XFB as coming from an unknown publisher. It is kept
// in its own .rc so xfb.rc, which carries the application icon, stays as it is.
//
// "1" is the numeric value of VS_VERSION_INFO. Using the literal avoids having
// to include <windows.h>, which keeps this compilable by rc.exe, llvm-rc and
// windres alike. In the same spirit the block below carries no comments, and
// the string values stay ASCII, so no resource compiler has to be told about a
// code page.  "040904b0" is US English (0x0409) + Unicode (0x04b0 = 1200) and
// must match the Translation value at the end.

1 VERSIONINFO
FILEVERSION    @XFB_VERSION_RC@
PRODUCTVERSION @XFB_VERSION_RC@
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Netpack - Online Solutions"
            VALUE "FileDescription",  "XFB Radio Automation Software"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "XFB"
            VALUE "LegalCopyright",   "Copyright (C) Netpack - Online Solutions. Licensed under GPL-3.0."
            VALUE "OriginalFilename", "XFB.exe"
            VALUE "ProductName",      "XFB"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
