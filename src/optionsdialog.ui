                <widget class="QComboBox" name="combo_iconTheme">
                 <property name="toolTip">
                  <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;How the icons are drawn. "Classic" is the full-colour artwork; the others re-draw that same artwork in one colour — the theme's text colour, or its accent — and "High contrast" draws it as heavily as it can, which is the one to reach for on a screen seen from across the studio. Applies immediately on Save.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                 </property>
                </widget>
