               </item>
               <item>
                <widget class="QPushButton" name="bt_clockFont">
                 <property name="toolTip">
                  <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The typeface the elapsed time of the track on air is drawn in — the "0:01:23 of 0:03:45" line under the programme name. Family, weight, slant and size; the size is held to what the player panel can show. Applies immediately on Save.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                 </property>
                 <property name="text">
                  <string>Choose…</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QToolButton" name="bt_clockFontReset">
