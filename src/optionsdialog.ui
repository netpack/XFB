          <item>
           <widget class="QGroupBox" name="grp_dbMaintenance">
            <property name="title">
             <string>Looking after it</string>
            </property>
            <layout class="QVBoxLayout" name="layout_dbMaintenance">
             <item>
              <layout class="QHBoxLayout" name="layout_dbMaintenanceButtons">
               <item>
                <widget class="QPushButton" name="bt_dbBackup">
                 <property name="toolTip">
                  <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Write a complete, consistent copy of the database to a file you choose. Safe to do while XFB is running and while a show is on air — the copy is taken through SQLite itself, not by copying the file behind its back.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                 </property>
                 <property name="text">
                  <string>Back up the database…</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="bt_dbCheck">
                 <property name="toolTip">
                  <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Ask SQLite to walk the whole file and report any damage. Reads only; it changes nothing.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                 </property>
                 <property name="text">
                  <string>Check it</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="bt_dbCompact">
                 <property name="toolTip">
                  <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Rebuild the file so the space left behind by deleted records is given back to the disk. Nothing is lost.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                 </property>
                 <property name="text">
                  <string>Compact it</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="bt_dbShow">
                 <property name="toolTip">
                  <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Open the folder the database sits in.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                 </property>
                 <property name="text">
                  <string>Show the file</string>
                 </property>
                </widget>
               </item>
               <item>
                <spacer name="hspacer_dbMaintenance">
                 <property name="orientation">
                  <enum>Qt::Orientation::Horizontal</enum>
                 </property>
                 <property name="sizeHint" stdset="0">
                  <size>
                   <width>40</width>
                   <height>20</height>
                  </size>
                 </property>
                </spacer>
               </item>
              </layout>
             </item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_dbDanger">
            <property name="title">
             <string>Careful — emptying a table cannot be undone</string>
