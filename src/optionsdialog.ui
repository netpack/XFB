            <property name="wordWrap">
             <bool>true</bool>
            </property>
            <property name="text">
             <string>XFB downloads audio with yt-dlp. The chosen format is produced with ffmpeg; if the selected encoder is unavailable, XFB automatically falls back to the next best open format. yt-dlp is installed in your home folder and kept up to date automatically before each download.</string>
            </property>
           </widget>
