# Host build directories (contain CMakeCache.txt pointing at host paths).
# Patterns are listed both at root and recursively (**/) to catch nested copies
# such as src/build/ and src/XFB.app/.
build/
**/build/
build-*/
**/build-*/
*-build/
pkg-root/
**/pkg-root/
pkg-build/
output/

# macOS app bundle and packaging artifacts
XFB.app/
**/XFB.app/
*.dmg
*.7z
*.icns
# Note: XFB.iconset/ is intentionally NOT ignored — its PNGs are installed as
# the Linux application icons (see src/CMakeLists.txt).

# Deployment staging trees. Pure build output — nothing under CMAKE_SOURCE_DIR
# reads them, and together they are the bulk of the context (over 1 GB).
dist/
**/dist/
dist-windows-x64/
dist-windows-arm64/

# Windows installers and the Visual Studio bootstrapper. By far the largest
# single item in the tree (~1.6 GB) and irrelevant to a Debian build.
*.exe
**/*.exe
*.exe:Zone.Identifier*

# Prebuilt packages
*.deb
**/*.deb
*.pkg.tar.zst

# Package-channel checkouts. These are DERIVED — regenerated by update-aur.sh,
# update-homebrew-tap.sh and update-debian-repo.sh — so shipping them into the
# builder only slows the context transfer down.
aur-xfb/
homebrew-xfb/
debian-repo/

# Version control and editor/IDE metadata
.git/
.vscode/
.kiro/
# Qt Creator's clangd index. Already in .gitignore, and missing here: 6561 of
# the 7522 files in the build context were this one cache, and all of them went
# into the source tarball the RPM is built from. Nothing reads it and no
# package ships it.
.qtc_clangd/
**/.qtc_clangd/
.qtcreator/
**/.qtcreator/
# Gradle's own cache, next to the android/app/build/ that build-*/ already
# catches. The companion APK the packages ship comes from
# packaging/companion/, not from a Gradle output tree, so none of this is
# needed to build.
.gradle/
**/.gradle/
# Agent session state, and — the reason this matters — the git worktrees kept
# under it: each one is a second copy of the whole source tree, which is most
# of the build context and ends up inside the source tarball the RPM is built
# from. Emulated (non-native) docker builds also fail outright trying to read
# through it: tar reports "Cannot open: Function not implemented".
.claude/
**/.claude/
.DS_Store
**/.DS_Store

# Temp/verification scratch dirs
tmp/
tmp_verify/
test_makefile/

# CMake stash
.qmake.stash
