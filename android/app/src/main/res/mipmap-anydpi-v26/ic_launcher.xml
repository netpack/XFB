<?xml version="1.0" encoding="utf-8"?>
<!--
    Without this, Android 8+ launchers mask the legacy PNG into whatever shape
    the phone uses and XFB's radio came out as an unrecognisable box.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/xfb_icon_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
