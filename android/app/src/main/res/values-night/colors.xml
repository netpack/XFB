<?xml version="1.0" encoding="utf-8"?>
<!-- XFB's "dark" spec, which is the desktop default. -->
<resources>
    <color name="xfb_window">#353535</color>
    <color name="xfb_base">#2A2A2A</color>
    <color name="xfb_alt">#424242</color>
    <color name="xfb_text">#E4E4E4</color>
    <color name="xfb_subtext">#A8A8A8</color>
    <color name="xfb_border">#555555</color>

    <color name="xfb_accent">#7C7CBA</color>
    <color name="xfb_on_accent">#000000</color>
    <!-- Behind the launcher icon; the radio itself is warm, so a cool near-white sets it off. -->
    <color name="xfb_icon_background">#ECEEF3</color>

    <!-- Periwinkle darkened until it sits on #2A2A2A without glowing. -->
    <color name="xfb_accent_container">#3A3A55</color>
    <color name="xfb_on_accent_container">#C7C7E8</color>

    <color name="xfb_brand_glow">#267C7CBA</color>
    <!-- See values/colors.xml; lifted rather than darkened against #2A2A2A. -->
    <color name="xfb_hairline">#24FFFFFF</color>
    <color name="xfb_well">#12FFFFFF</color>
</resources>
