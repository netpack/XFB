<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!--
        The list refreshes itself while the screen is open, but a station that
        has just had a playlist saved on it is exactly when someone reaches for
        this, and waiting out a poll for no visible reason feels broken.
    -->
    <item
        android:id="@+id/action_refresh"
        android:icon="@drawable/ic_refresh"
        android:title="@string/playlists_refresh"
        app:showAsAction="ifRoom" />

    <!--
        In the overflow rather than on the bar: it throws away every downloaded
        track, and that is not something to put a thumb's width from Refresh.
    -->
    <item
        android:id="@+id/action_delete_downloads"
        android:title="@string/downloads_delete"
        app:showAsAction="never" />
</menu>
