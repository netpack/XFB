<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!--
        Shuffle is a mode rather than a transport action, so it sits with the
        other settings up here instead of crowding the transport row, where it
        would also break the symmetry of prev / play / next.
    -->
    <item
        android:id="@+id/action_shuffle"
        android:icon="@drawable/ic_shuffle"
        android:title="@string/player_shuffle"
        app:showAsAction="ifRoom" />

    <!--
        The FX section is reachable from the player as well as the front
        screen: shaping the sound is something you do while listening.
    -->
    <!--
        Auto-mix is a preference rather than something you reach for mid-set, so
        it lives in the overflow with its state on a checkbox. The transport bar
        stays prev / play / next.
    -->
    <item
        android:id="@+id/action_automix"
        android:checkable="true"
        android:icon="@drawable/ic_crossfade"
        android:title="@string/automix_title"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_fx"
        android:icon="@drawable/ic_fx"
        android:title="@string/fx_title"
        app:showAsAction="ifRoom" />
</menu>
