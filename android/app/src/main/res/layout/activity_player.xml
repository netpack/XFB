<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_appbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="@dimen/xfb_screen_margin">

            <!-- Deck: the platter beside what is on it, the way the desktop
                 pairs a deck with its track information.

                 The card carries no padding of its own so the backdrop can
                 reach its edges; the content below brings its own. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentPadding="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- The cover art, blurred, behind the deck — as behind the
                         media notification this screen mirrors. -->
                    <pt.netpack.xfb.companion.BackdropView
                        android:id="@+id/backdrop"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/xfb_card_padding">

                    <pt.netpack.xfb.companion.TurntableView
                        android:id="@+id/turntable"
                        android:layout_width="@dimen/xfb_turntable"
                        android:layout_height="@dimen/xfb_turntable" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/xfb_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/titleLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.Xfb.TrackTitle" />

                        <TextView
                            android:id="@+id/artistLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/xfb_subtext" />

                        <TextView
                            android:id="@+id/positionLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/xfb_gap_tight"
                            android:textAppearance="@style/TextAppearance.Xfb.Readout" />
                    </LinearLayout>
                </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- On air: the same strip the desktop shows above its playlist. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/xfb_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stripLabel"
                        style="@style/Widget.Xfb.SectionLabel"
                        android:text="@string/player_on_air" />

                    <pt.netpack.xfb.companion.WaveStripView
                        android:id="@+id/strip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/xfb_gap_small" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Transport. The play button is the one large, filled target on
                 the screen; prev and next sit either side as plain icons. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/xfb_gap_large"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/previousButton"
                    style="@style/Widget.Xfb.TransportButton"
                    android:layout_width="@dimen/xfb_icon_button"
                    android:layout_height="@dimen/xfb_icon_button"
                    android:contentDescription="@string/player_previous"
                    app:icon="@drawable/ic_skip_previous" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/playButton"
                    style="@style/Widget.Xfb.PlayButton"
                    android:layout_width="@dimen/xfb_transport_button"
                    android:layout_height="@dimen/xfb_transport_button"
                    android:layout_marginHorizontal="@dimen/xfb_gap_large"
                    android:contentDescription="@string/player_play"
                    app:icon="@drawable/ic_play" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nextButton"
                    style="@style/Widget.Xfb.TransportButton"
                    android:layout_width="@dimen/xfb_icon_button"
                    android:layout_height="@dimen/xfb_icon_button"
                    android:contentDescription="@string/player_next"
                    app:icon="@drawable/ic_skip_next" />
            </LinearLayout>

            <!-- The transition out of this track, editable while it plays. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/crossfadeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/xfb_gap_large"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/crossfadeLabel"
                        style="@style/Widget.Xfb.SectionLabel" />

                    <pt.netpack.xfb.companion.CrossfadeView
                        android:id="@+id/crossfade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/xfb_gap_small" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
