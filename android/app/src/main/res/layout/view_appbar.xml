<?xml version="1.0" encoding="utf-8"?>
<!--
    The one app bar every screen includes, so titles, back arrows and the
    hairline under them cannot drift apart from screen to screen.
-->
<com.google.android.material.appbar.AppBarLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/xfb_window"
    app:elevation="0dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIconTint="@color/xfb_text" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/xfb_border" />
</com.google.android.material.appbar.AppBarLayout>
