    <!--
        The button's own label, which is what a screen reader announces. It has
        to say which way the switch is currently set: "Shuffle off" on a button
        reads as though tapping it would turn shuffle off.
    -->
    <string name="player_shuffle_is_on">Shuffle is on</string>
    <string name="player_shuffle_is_off">Shuffle is off</string>

